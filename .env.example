# Скопируйте в .env и подставьте свои значения:
#   cp .env.example .env
#
# Docker Compose подхватывает .env из этого каталога автоматически.

# Имя БД, пользователь и пароль (используются в mysql + app)
skills_exchange=skills_exchange
skills_user=skills_user
skills_pass=skills_pass

# Пароль root в контейнере MySQL
rootpass=root_secret_change_me

# Публичный URL прокси (редирект /admin/* с PHP, если запрос попал на app).
# Должен совпадать с тем, как вы открываете сайт (порт прокси, обычно 8080).
APP_URL=http://localhost:8080

# Если вы заходите только через admin.localhost:8080, задайте тот же URL, чтобы
# редиректы с PHP не отправляли на localhost.
# APP_URL=http://admin.localhost:8080

# Админ-панель /admin (Next + /api/admin/*)
# Если не задать — в docker-compose.yml подставятся значения по умолчанию.
ADMIN_PASSWORD=bartery_admin_change_me
ADMIN_JWT_SECRET=bartery-dev-admin-jwt-secret-minimum-32chars-ok

# Хост для «отдельного домена» админки (Next middleware). Совпадает с docker-compose.
NEXT_PUBLIC_ADMIN_HOST=admin.localhost

# Jitsi для видеозвонков в чате (только hostname, без https://). Сборка frontend.
# NEXT_PUBLIC_JITSI_DOMAIN=calls.disroot.org
